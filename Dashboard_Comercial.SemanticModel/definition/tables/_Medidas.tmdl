table _Medidas
	lineageTag: ee862beb-c68c-4119-92f0-13229c22c466

	measure 'Total Faturamento' =
			
			SUM(fVendas[Valor Venda])
		lineageTag: 4ad36d27-29e2-40cb-8b31-c5f6b6aa1d08

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qtd Novos Clientes' =
			
			VAR vMenorMes = MIN(dCalendario[Data])
			VAR vMaiorMes = MAX(dCalendario[Data])
			
			VAR vTabela =
			FILTER(
			    VALUES(dCliente[ID Cliente]),
			    VAR vPrimeiraCompra =
			    CALCULATE(
			        MIN(fVendas[Data Venda]),
			        ALL(dCalendario)
			    )
			    RETURN
			    vPrimeiraCompra >= vMenorMes && vPrimeiraCompra <= vMaiorMes
			)
			RETURN
			COUNTROWS(vTabela)
		formatString: 0
		lineageTag: e434f5db-772a-4ebc-822b-f78781c7f912

	measure 'Total Custo' = SUM(fVendas[Custo Venda])
		lineageTag: b123da74-e069-4320-99ee-76bedfe99cce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Lucro = [Total Faturamento] - [Total Custo]
		lineageTag: 2dcfa65a-f176-46cd-8e4f-8259a7726b03

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quantidade Cliente' = DISTINCTCOUNT(fVendas[ID Cliente])
		formatString: 0
		lineageTag: a983fd2b-d04b-4087-aee5-e3be6e15b745

	column Value
		formatString: 0
		lineageTag: cf679cf6-5b37-4e21-bb4c-dfd292ca13ca
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Medidas = calculated
		mode: import
		source = {1}

	annotation PBI_Id = f41f1564d2d64e4a9bbecd387d437bc2

