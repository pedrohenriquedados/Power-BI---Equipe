expression 'fMeta 2017' =
		let
		    Fonte = BaseDados,
		    #"W:\OneDrive - Aprenda Power BI\Cursos Online\_Arquivos\TrilhaChampion_v3 0\M2  Power Query e Linguagem M\BaseDadosPrincipal\Fatos\_Meta 2017 csv" = Fonte{[#"Folder Path"="W:\OneDrive - Aprenda Power BI\Cursos Online\_Arquivos\TrilhaChampion_v3.0\M2. Power Query e Linguagem M\BaseDadosPrincipal\Fatos\",Name="Meta 2017.csv"]}[Content],
		    #"CSV Importado" = Csv.Document(#"W:\OneDrive - Aprenda Power BI\Cursos Online\_Arquivos\TrilhaChampion_v3 0\M2  Power Query e Linguagem M\BaseDadosPrincipal\Fatos\_Meta 2017 csv",[Delimiter=";", Columns=5, Encoding=1252, QuoteStyle=QuoteStyle.None]),
		    LinhasFiltradas = Table.SelectRows(#"CSV Importado", each [Column2] <> null and [Column2] <> ""),
		    CabeçalhosPromovidos = Table.PromoteHeaders(LinhasFiltradas, [PromoteAllScalars=true]),
		    ColunasNãoDinâmicas = Table.UnpivotOtherColumns(CabeçalhosPromovidos, {"Categoria", "Data Revisão"}, "Continente", "ValorMeta"),
		    // Foram agrupadas as colunas Categoria e Continente
		    LinhasAgrupadas = Table.Group(ColunasNãoDinâmicas, {"Categoria", "Continente"}, {{"Tabela", each _, type table [Categoria=nullable text, Data Revisão=nullable date, Continente=nullable text, ValorMeta=nullable number]}}),
		    PersonalizaçãoAdicionada = Table.AddColumn(LinhasAgrupadas, "ValorFinal", each Table.Max([Tabela], "Data Revisão")),
		    OutrasColunasRemovidas = Table.SelectColumns(PersonalizaçãoAdicionada,{"ValorFinal"}),
		    ValorFinalExpandido = Table.ExpandRecordColumn(OutrasColunasRemovidas, "ValorFinal", {"Categoria", "Continente", "ValorMeta"}, {"Categoria", "Continente", "ValorMeta"}),
		    PersonalizaçãoAdicionada1 = Table.AddColumn(ValorFinalExpandido, "DataMeta", each #date(2017, 01, 01)),
		    TipoAlterado = Table.TransformColumnTypes(PersonalizaçãoAdicionada1,{{"Categoria", type text}, {"Continente", type text}, {"ValorMeta", Currency.Type}, {"DataMeta", type date}})
		in
		    TipoAlterado
	lineageTag: 4c15cb01-001b-4b5e-a8f6-f4890b77bea9

